{
  "info": {
    "_postman_id": "8a329d91-e40f-488b-9679-mini-erp-crm",
    "name": "Mini ERP + CRM Operations API",
    "description": "Comprehensive Postman Collection for Mini ERP + CRM Operations Portal (Wholesale & Distribution)\nTech Stack: Node.js + Fastify (ES Modules), Supabase Auth, PostgreSQL (Prisma), Redis, AWS S3, and PDFKit.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "customerId",
      "value": "",
      "type": "string"
    },
    {
      "key": "productId",
      "value": "",
      "type": "string"
    },
    {
      "key": "challanId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. System Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Authentication & Roles",
      "item": [
        {
          "name": "Login - Admin Role",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set('authToken', jsonData.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@erp.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Login - Sales Role",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sales@erp.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Login - Warehouse Role",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"warehouse@erp.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Login - Accounts Role",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"accounts@erp.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Sync Supabase User Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"supabaseToken\": \"YOUR_SUPABASE_ACCESS_TOKEN\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/sync",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "sync"]
            }
          }
        },
        {
          "name": "Get Current Profile (Me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        },
        {
          "name": "List All Users (Admin Only)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/auth/users",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "users"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Customer CRM",
      "item": [
        {
          "name": "List Customers (Search & Filter)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.length > 0) {",
                  "    pm.collectionVariables.set('customerId', jsonData.data[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/customers?page=1&limit=10&status=ACTIVE",
              "host": ["{{baseUrl}}"],
              "path": ["customers"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "status", "value": "ACTIVE" }
              ]
            }
          }
        },
        {
          "name": "Get Customer Details by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/customers/{{customerId}}",
              "host": ["{{baseUrl}}"],
              "path": ["customers", "{{customerId}}"]
            }
          }
        },
        {
          "name": "Create New Customer",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rohan Kapoor\",\n  \"businessName\": \"Kapoor Electrical Agencies\",\n  \"mobile\": \"+91 99887 66554\",\n  \"email\": \"rohan@kapoorelectrical.com\",\n  \"gstNumber\": \"27AABCK5678L1Z9\",\n  \"customerType\": \"DISTRIBUTOR\",\n  \"status\": \"LEAD\",\n  \"address\": \"Shop 14, Electronic Market, Grant Road, Mumbai - 400007\",\n  \"followUpDate\": \"2026-09-10\",\n  \"notes\": \"Interested in high-torque servo motors\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/customers",
              "host": ["{{baseUrl}}"],
              "path": ["customers"]
            }
          }
        },
        {
          "name": "Add Follow-Up Note to Customer",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"note\": \"Discussed wholesale quantity discount on motors. Client agreed to review quote.\",\n  \"followUpDate\": \"2026-09-12\",\n  \"updateCustomerStatus\": \"ACTIVE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/customers/{{customerId}}/notes",
              "host": ["{{baseUrl}}"],
              "path": ["customers", "{{customerId}}", "notes"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Product & Inventory",
      "item": [
        {
          "name": "List Products (Search & Low Stock Filter)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.length > 0) {",
                  "    pm.collectionVariables.set('productId', jsonData.data[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/products?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Industrial Pneumatic Cylinder 50mm\",\n  \"sku\": \"PNU-CYL-050MM\",\n  \"category\": \"Pneumatics\",\n  \"unitPrice\": 4500.00,\n  \"currentStock\": 50,\n  \"minStockAlert\": 10,\n  \"location\": \"Warehouse Bay B-02\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": ["{{baseUrl}}"],
              "path": ["products"]
            }
          }
        },
        {
          "name": "List Stock Movements Log",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/inventory/movements?page=1&limit=15",
              "host": ["{{baseUrl}}"],
              "path": ["inventory", "movements"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "15" }
              ]
            }
          }
        },
        {
          "name": "Manual Stock Adjustment (IN/OUT)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 20,\n  \"movementType\": \"IN\",\n  \"reason\": \"Supplier Inward Batch #992\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/inventory/adjust",
              "host": ["{{baseUrl}}"],
              "path": ["inventory", "adjust"]
            }
          }
        }
      ]
    },
    {
      "name": "5. Sales Challans & Dispatch",
      "item": [
        {
          "name": "Create Sales Challan (Draft or Confirmed)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.id) {",
                  "    pm.collectionVariables.set('challanId', jsonData.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"status\": \"DRAFT\",\n  \"notes\": \"Express delivery via Cargo Line\",\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"quantity\": 5,\n      \"unitPrice\": 12500.00\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/challans",
              "host": ["{{baseUrl}}"],
              "path": ["challans"]
            }
          }
        },
        {
          "name": "List Sales Challans",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/challans?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["challans"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get Challan Details by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/challans/{{challanId}}",
              "host": ["{{baseUrl}}"],
              "path": ["challans", "{{challanId}}"]
            }
          }
        },
        {
          "name": "Confirm Sales Challan (Atomic Stock Deduction)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/challans/{{challanId}}/confirm",
              "host": ["{{baseUrl}}"],
              "path": ["challans", "{{challanId}}", "confirm"]
            }
          }
        },
        {
          "name": "Cancel Sales Challan (Restores Inventory)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Client requested order cancellation before dispatch.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/challans/{{challanId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["challans", "{{challanId}}", "cancel"]
            }
          }
        }
      ]
    },
    {
      "name": "6. Invoices & PDF Export",
      "item": [
        {
          "name": "List Confirmed Billing Invoices",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/invoices",
              "host": ["{{baseUrl}}"],
              "path": ["invoices"]
            }
          }
        },
        {
          "name": "Download Tax Invoice PDF Stream",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/invoices/{{challanId}}/pdf",
              "host": ["{{baseUrl}}"],
              "path": ["invoices", "{{challanId}}", "pdf"]
