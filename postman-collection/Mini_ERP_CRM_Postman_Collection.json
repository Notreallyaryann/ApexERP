          }
        },
        {
          "name": "Download Delivery Challan PDF Stream",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/invoices/{{challanId}}/challan-pdf",
              "host": ["{{baseUrl}}"],
              "path": ["invoices", "{{challanId}}", "challan-pdf"]
            }
          }
        }
      ]
    },
    {
      "name": "7. Dashboard & Analytics (Redis Cached)",
      "item": [
        {
          "name": "Get Aggregated Operations Stats",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/dashboard/stats",
              "host": ["{{baseUrl}}"],
              "path": ["dashboard", "stats"]
            }
          }
        }
      ]
    }
  ]
